<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aavaas Studios - Spaces. Designed Differently.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-stone-950 text-stone-100 antialiased selection:bg-amber-600 selection:text-white">

    <!-- Compact Header -->
    <header class="sticky top-0 z-50 bg-stone-900/90 backdrop-blur-md border-b border-stone-800">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-lg font-bold tracking-wider uppercase">Aavaas Studios</span>
                <span class="text-amber-500 text-xs">✨</span>
            </div>
            
            <div class="flex items-center gap-6 text-sm">
                <a href="tel:9716446982" class="hidden sm:flex items-center gap-2 text-amber-400 font-medium hover:text-amber-300 transition-colors">
                    <i class="fa-solid fa-phone text-xs"></i> 9716446982
                </a>
                <a href="#main-content" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-medium transition-all shadow-md shadow-amber-900/30">
                    Get in Touch
                </a>
            </div>
        </div>
    </header>

    <!-- Main Single Page / Multi-Column Dashboard Layout -->
    <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 py-8 lg:py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Brand Identity, Intro & Contact Card (Span 5) -->
            <div class="lg:col-span-5 space-y-6">
                <!-- Brand Hero Card -->
                <div class="bg-stone-900 border border-stone-800 rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-2xl">
                    <div class="absolute top-0 right-0 w-48 h-48 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>
                    
                    <span class="inline-block py-1 px-3 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
                        Spaces. Designed Differently. ✨
                    </span>
                    
                    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-3">
                        Design. Detail. Aavaas.
                    </h1>
                    
                    <p class="text-stone-300 text-sm sm:text-base leading-relaxed font-light mb-6">
                        We create modern, functional and timeless interiors designed around the way you live. From a single room to complete spaces, we bring together design, planning, sourcing and execution.
                    </p>

                    <!-- Quick Contacts Column List -->
                    <div class="space-y-3 pt-4 border-t border-stone-800 text-sm">
                        <a href="tel:9716446982" class="flex items-center gap-3 text-stone-300 hover:text-amber-400 transition-colors group">
                            <div class="w-9 h-9 rounded-lg bg-stone-800 flex items-center justify-center text-amber-500 group-hover:bg-amber-600 group-hover:text-white transition-all shrink-0">
                                <i class="fa-solid fa-phone text-xs"></i>
                            </div>
                            <span class="font-medium">9716446982</span>
                        </a>

                        <a href="mailto:aavaasstudios@gmail.com" class="flex items-center gap-3 text-stone-300 hover:text-amber-400 transition-colors group">
                            <div class="w-9 h-9 rounded-lg bg-stone-800 flex items-center justify-center text-amber-500 group-hover:bg-amber-600 group-hover:text-white transition-all shrink-0">
                                <i class="fa-solid fa-envelope text-xs"></i>
                            </div>
                            <span class="font-medium">aavaasstudios@gmail.com</span>
                        </a>

                        <div class="flex items-center gap-3 text-stone-300">
                            <div class="w-9 h-9 rounded-lg bg-stone-800 flex items-center justify-center text-amber-500 shrink-0">
                                <i class="fa-solid fa-location-dot text-xs"></i>
                            </div>
                            <span class="font-medium">Serving clients in different parts of Nepal</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Inquiry Form Card -->
                <div class="bg-stone-900 border border-stone-800 rounded-3xl p-6 sm:p-8 shadow-xl">
                    <h2 class="text-xl font-bold text-white mb-2">DM / Message Us</h2>
                    <p class="text-stone-400 text-xs mb-6">Discuss your space requirements with our designers.</p>
                    
                    <form id="quick-form" onsubmit="handleQuickSubmit(event)" class="space-y-4 text-sm">
                        <div>
                            <input type="text" id="fname" required placeholder="Your Name" class="w-full px-4 py-3 rounded-xl bg-stone-950 border border-stone-800 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition-all">
                        </div>
                        <div>
                            <input type="email" id="femail" required placeholder="Email or Phone" class="w-full px-4 py-3 rounded-xl bg-stone-950 border border-stone-800 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition-all">
                        </div>
                        <div>
                            <textarea id="fmsg" rows="3" required placeholder="Tell us about your space..." class="w-full px-4 py-3 rounded-xl bg-stone-950 border border-stone-800 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition-all"></textarea>
                        </div>
                        <button type="submit" class="w-full py-3 bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-xl transition-all shadow-lg shadow-amber-900/20">
                            Send Inquiry
                        </button>
                        <div id="form-success" class="hidden text-center text-xs font-medium text-emerald-400 mt-2">
                            ✓ Message sent successfully! We'll connect soon.
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Column: Services & Portfolio Showcase Grid (Span 7) -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- Services Multi-Column Grid -->
                <div class="bg-stone-900 border border-stone-800 rounded-3xl p-6 sm:p-8 shadow-xl">
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center justify-between">
                        <span>Our Expertise & Services</span>
                        <span class="text-xs text-amber-500 font-normal">End-to-End Solutions</span>
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Service Item -->
                        <div class="p-4 rounded-2xl bg-stone-950/60 border border-stone-800/80 hover:border-amber-600/50 transition-all">
                            <span class="text-xl mb-2 block">🏠</span>
                            <h3 class="font-semibold text-white text-sm mb-1">Residential Interiors</h3>
                            <p class="text-stone-400 text-xs leading-relaxed">Custom living spaces tailored around your lifestyle.</p>
                        </div>

                        <div class="p-4 rounded-2xl bg-stone-950/60 border border-stone-800/80 hover:border-amber-600/50 transition-all">
                            <span class="text-xl mb-2 block">🏢</span>
                            <h3 class="font-semibold text-white text-sm mb-1">Commercial Spaces</h3>
                            <p class="text-stone-400 text-xs leading-relaxed">Productive offices & engaging retail outlets.</p>
                        </div>

                        <div class="p-4 rounded-2xl bg-stone-950/60 border border-stone-800/80 hover:border-amber-600/50 transition-all">
                            <span class="text-xl mb-2 block">📐</span>
                            <h3 class="font-semibold text-white text-sm mb-1">2D & 3D Design</h3>
                            <p class="text-stone-400 text-xs leading-relaxed">Immersive visualizations before execution.</p>
                        </div>

                        <div class="p-4 rounded-2xl bg-stone-950/60 border border-stone-800/80 hover:border-amber-600/50 transition-all">
                            <span class="text-xl mb-2 block">🛋️</span>
                            <h3 class="font-semibold text-white text-sm mb-1">Furniture & Décor</h3>
                            <p class="text-stone-400 text-xs leading-relaxed">Curated furniture & artisanal decorative elements.</p>
                        </div>

                        <div class="p-4 rounded-2xl bg-stone-950/60 border border-stone-800/80 hover:border-amber-600/50 transition-all">
                            <span class="text-xl mb-2 block">💡</span>
                            <h3 class="font-semibold text-white text-sm mb-1">Lighting & Material</h3>
                            <p class="text-stone-400 text-xs leading-relaxed">Layered lighting and premium material planning.</p>
                        </div>

                        <div class="p-4 rounded-2xl bg-stone-950/60 border border-stone-800/80 hover:border-amber-600/50 transition-all">
                            <span class="text-xl mb-2 block">🔨</span>
                            <h3 class="font-semibold text-white text-sm mb-1">Project Supervision</h3>
                            <p class="text-stone-400 text-xs leading-relaxed">End-to-end execution and quality oversight.</p>
                        </div>
                    </div>
                </div>

                <!-- Portfolio Gallery Column Strip -->
                <div class="bg-stone-900 border border-stone-800 rounded-3xl p-6 sm:p-8 shadow-xl">
                    <h2 class="text-xl font-bold text-white mb-4">Featured Spaces</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="relative rounded-2xl overflow-hidden h-48 group">
                            <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=600&auto=format&fit=crop" alt="Living" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                                <span class="text-xs font-semibold text-amber-400">Minimalist Living</span>
                            </div>
                        </div>
                        <div class="relative rounded-2xl overflow-hidden h-48 group">
                            <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?q=80&w=600&auto=format&fit=crop" alt="Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                                <span class="text-xs font-semibold text-amber-400">Modern Kitchen</span>
                            </div>
                        </div>
                        <div class="relative rounded-2xl overflow-hidden h-48 group">
                            <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=600&auto=format&fit=crop" alt="Office" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-3">
                                <span class="text-xs font-semibold text-amber-400">Executive Office</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-800 mt-12 py-8 bg-stone-900/50 text-center text-xs text-stone-500">
        <p class="mb-1">&copy; 2026 Aavaas Studios. Design. Detail. Aavaas.</p>
        <p>Contact: <a href="tel:9716446982" class="text-amber-400 font-medium">9716446982</a> | Email: aavaasstudios@gmail.com</p>
    </footer>

    <script>
        function handleQuickSubmit(e) {
            e.preventDefault();
            const successMsg = document.getElementById('form-success');
            successMsg.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => {
                successMsg.classList.add('hidden');
            }, 4000);
        }
    </script>
</body>
</html>
